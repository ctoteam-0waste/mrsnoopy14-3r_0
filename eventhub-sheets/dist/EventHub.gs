/** Columns that hold IDs or phone numbers: formatted as plain text so Sheets never reformats them. */
var TEXT_COLUMNS = ['Event ID', 'Task ID', 'Registration ID', 'User ID', 'Submission ID', 'Txn ID', 'Ref ID',
  'Certificate ID', 'Phone', 'Drive file ID', 'Log ID', 'Slug'];

function prop_(key, fallback) {
  var v = PropertiesService.getScriptProperties().getProperty(key);
  return v === null || v === undefined || v === '' ? fallback : v;
}

function apiBase_() {
  return String(prop_('API_BASE', 'https://api.karmaverse.earth')).replace(/\/+$/, '');
}

function siteUrl_() {
  return String(prop_('SITE_URL', 'https://karmaverse.earth')).replace(/\/+$/, '');
}

// ==================== Db.gs ====================

/** Thin table layer over the tabs: rows in and out as objects keyed by header. */

function httpError_(status, message) {
  var err = new Error(message);
  err.httpStatus = status;
  return err;
}

var SS_ = null;
function spreadsheet_() {
  if (SS_) return SS_;
  var id = prop_('SPREADSHEET_ID', '');
  SS_ = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  return SS_;
}

function sheet_(tab) {
  var s = spreadsheet_().getSheetByName(tab.name);
  if (!s) throw httpError_(500, 'Missing tab "' + tab.name + '". Run setupEventHub.');
  return s;
}

/** Header row of a tab, read once per request. */
var HDR_ = {};
function headers_(tab) {
  if (HDR_[tab.name]) return HDR_[tab.name];
  var s = sheet_(tab);
  var n = Math.max(s.getLastColumn(), 1);
  HDR_[tab.name] = s.getRange(1, 1, 1, n).getValues()[0].map(String);
  return HDR_[tab.name];
}

function rowObject_(header, values, rowNumber) {
  var o = { _row: rowNumber };
  for (var c = 0; c < header.length; c++) if (header[c]) o[header[c]] = values[c];
  return o;
}

function isBlankRow_(r) {
  return r.every(function (c) { return c === '' || c === null; });
}

/** Reads a whole tab. Each row object also carries `_row` (its sheet row number). */
function readRows_(tab) {
  var values = sheet_(tab).getDataRange().getValues();
  if (values.length < 2) return [];
  var header = values[0].map(String);
  var rows = [];
  for (var i = 1; i < values.length; i++) {
    if (isBlankRow_(values[i])) continue;
    rows.push(rowObject_(header, values[i], i + 1));
  }
  return rows;
}

/**
 * Rows whose `header` cell equals `value` exactly. Uses the sheet's own search, so a
 * user's few rows are found without reading thousands of others.
 */
function rowsWhere_(tab, header, value) {
  var s = sheet_(tab);
  var hdr = headers_(tab);
  var idx = hdr.indexOf(header);
  if (idx === -1) throw httpError_(500, 'Column "' + header + '" missing in ' + tab.name);
  var last = s.getLastRow();
  if (last < 2 || value === '' || value === null || value === undefined) return [];
  var cells = s.getRange(2, idx + 1, last - 1, 1).createTextFinder(String(value)).matchEntireCell(true).matchCase(true).findAll();
  var rows = [];
  cells.forEach(function (cell) {
    var r = cell.getRow();
    var vals = s.getRange(r, 1, 1, hdr.length).getValues()[0];
    if (String(vals[idx]) === String(value)) rows.push(rowObject_(hdr, vals, r));
  });
  rows.sort(function (a, b) { return a._row - b._row; });
  return rows;
}

function rowWhere_(tab, header, value) {
  return rowsWhere_(tab, header, value)[0] || null;
}

/** One column's values (no header), e.g. to count registrations per event cheaply. */
function columnValues_(tab, header) {
  var s = sheet_(tab);
  var idx = headers_(tab).indexOf(header);
  if (idx === -1) throw httpError_(500, 'Column "' + header + '" missing in ' + tab.name);
  var last = s.getLastRow();
  if (last < 2) return [];
  return s.getRange(2, idx + 1, last - 1, 1).getValues().map(function (r) { return r[0]; });
}

/**
 * Anything a user typed is written as plain text: a caption like "=IMPORTXML(...)"
 * must never become a live formula in the team's spreadsheet.
 */
function safeText_(v) {
  if (v === null || v === undefined) return '';
  if (v instanceof Date || typeof v === 'number' || typeof v === 'boolean') return v;
  var s = String(v);
  return /^[=+\-@\t\r]/.test(s) ? "'" + s : s;
}

/** Reverses safeText_ for values read back from the sheet. */
function plain_(v) {
  if (v === null || v === undefined) return '';
  return String(v).replace(/^'/, '');
}

function appendRow_(tab, obj) {
  var hdr = headers_(tab);
  sheet_(tab).appendRow(hdr.map(function (h) { return h in obj ? safeText_(obj[h]) : ''; }));
}

function updateCells_(tab, rowNumber, obj) {
  var s = sheet_(tab);
  var hdr = headers_(tab);
  Object.keys(obj).forEach(function (h) {
    var idx = hdr.indexOf(h);
    if (idx === -1) throw httpError_(500, 'Column "' + h + '" missing in ' + tab.name);
    s.getRange(rowNumber, idx + 1).setValue(safeText_(obj[h]));
  });
}

/**
 * Every check-then-write runs inside one script-wide lock, so two taps can never
 * create two registrations, two submissions for one task, or two certificates.
 */
var LOCK_DEPTH_ = 0;
function withLock_(fn) {
  if (LOCK_DEPTH_ > 0) return fn();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw httpError_(503, 'We are very busy right now. Please try again in a moment.');
  LOCK_DEPTH_++;
  try {
    var out = fn();
    SpreadsheetApp.flush();
    return out;
  } finally {
    LOCK_DEPTH_--;
    lock.releaseLock();
  }
}

function toDate_(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
  if (v === '' || v === null || v === undefined) return null;
  var d = new Date(v);
  return isNaN(d.getTime()) ? null : d;
}

function iso_(d) {
  var x = toDate_(d);
  return x ? x.toISOString() : null;
}

function truthy_(v) {
  return v === true || String(v).toUpperCase() === 'TRUE' || String(v).toLowerCase() === 'yes';
}

function num_(v, fallback) {
  var n = Number(v);
  return v === '' || v === null || v === undefined || isNaN(n) ? fallback : n;
}

function uuid_() {
  return Utilities.getUuid();
}

/** Short, unguessable, unambiguous ID (no 0/O/1/I). */
function shortId_(prefix, len) {
  var alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  var hex = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
  var out = '';
  for (var i = 0; i < len; i++) out += alphabet.charAt(parseInt(hex.substr(i * 2, 2), 16) % alphabet.length);
  return prefix + out;
}

/** Splits a multi-line cell into a clean list (one item per line, bullets stripped). */
function lines_(v) {
  return plain_(v).split(/\r?\n/).map(function (s) { return s.replace(/^\s*[-•*]\s*/, '').trim(); }).filter(Boolean);
}

/** Trimmed string, or a 400 if it's not a string within the length limits. */
function str_(v, label, min, max) {
  var s = typeof v === 'string' ? v.trim() : v === undefined || v === null ? '' : String(v).trim();
  if (s.length < min) throw httpError_(400, min <= 1 ? label + ' is required.' : label + ' must be at least ' + min + ' characters.');
  if (s.length > max) throw httpError_(400, label + ' must be ' + max + ' characters or fewer.');
  return s;
}

/** Calendar date in India for daily stats, e.g. "2026-12-07". */
function istDate_(d) {
  return Utilities.formatDate(toDate_(d) || new Date(0), CONFIG.TIME_ZONE, 'yyyy-MM-dd');
}

function cacheGetJson_(key) {
  var hit = CacheService.getScriptCache().get(key);
  return hit ? JSON.parse(hit) : null;
}

function cachePutJson_(key, obj, seconds) {
  var s = JSON.stringify(obj);
  if (s.length < 95000) CacheService.getScriptCache().put(key, s, seconds);
}

// ==================== Events.gs ====================

/**
 * Events and their daily tasks. The team can edit both in the sheet or through
 * /admin/events; the public only ever sees published events.
 */

// ------------------------------------------------------------------ parsing

/** "Q: ...\nA: ...\n\nQ: ..." -> [{ q, a }] */
function parseFaq_(v) {
  var out = [];
  var cur = null;
  plain_(v).split(/\r?\n/).forEach(function (line) {
    var t = line.trim();
    if (!t) return;
    var q = t.match(/^Q[:.)-]\s*(.*)$/i);
    var a = t.match(/^A[:.)-]\s*(.*)$/i);
    if (q) { cur = { q: q[1], a: '' }; out.push(cur); }
    else if (a && cur) cur.a = (cur.a ? cur.a + ' ' : '') + a[1];
    else if (cur) cur.a = (cur.a ? cur.a + ' ' : '') + t;
  });
  return out.filter(function (f) { return f.q && f.a; });
}

function eventFromRow_(r) {
  return {
    id: plain_(r['Event ID']),
    slug: plain_(r['Slug']).trim().toLowerCase(),
    title: plain_(r['Title']),
    category: plain_(r['Category']),
    published: truthy_(r['Published']),
    featured: truthy_(r['Featured']),
    summary: plain_(r['Short description']),
    bannerUrl: plain_(r['Banner URL']),
    overview: plain_(r['Overview']),
    objectives: lines_(r['Objectives']),
    eligibility: lines_(r['Eligibility']),
    rules: lines_(r['Rules']),
    rewards: lines_(r['Rewards']),
    faq: parseFaq_(r['FAQ']),
    audience: plain_(r['Audience']),
    fee: plain_(r['Registration fee']) || 'Free',
    startAt: iso_(r['Starts at']),
    endAt: iso_(r['Ends at']),
    regOpensAt: iso_(r['Registration opens']),
    regClosesAt: iso_(r['Registration closes']),
    maxParticipants: num_(r['Max participants'], 0),
    lateSubmissions: truthy_(r['Late submissions']),
    pickupBonus: num_(r['Pickup bonus points'], 0),
    certificatesEnabled: truthy_(r['Certificates enabled']),
    certificateRule: plain_(r['Certificate rule']) || 'minApprovedTasks=1',
    _row: r._row,
  };
}

function taskFromRow_(r) {
  var accepts = plain_(r['Accepts']).toLowerCase().split(/[,\s|]+/).filter(function (a) {
    return CONFIG.ACCEPTS.indexOf(a) !== -1;
  });
  return {
    id: plain_(r['Task ID']),
    eventId: plain_(r['Event ID']),
    day: num_(r['Day'], 0),
    title: plain_(r['Title']),
    instructions: plain_(r['Instructions']),
    accepts: accepts.length ? accepts : ['text'],
    points: Math.max(0, num_(r['Points'], 0)),
    qualityMax: Math.max(0, num_(r['Quality max'], 0)),
    autoApprove: truthy_(r['Auto approve']),
    allowResubmit: r['Allow resubmit'] === '' ? true : truthy_(r['Allow resubmit']),
    opensAt: iso_(r['Opens at']),
    closesAt: iso_(r['Closes at']),
    bonusRule: plain_(r['Bonus rule']).trim(),
    active: r['Active'] === '' ? true : truthy_(r['Active']),
    _row: r._row,
  };
}

/** Every event row (drafts included), cached for a minute. Rows missing an ID, slug or dates are skipped. */
function allEvents_() {
  var hit = cacheGetJson_('events');
  if (hit) return hit;
  var list = readRows_(TABS.EVENTS).map(eventFromRow_).filter(function (e) {
    return e.id && e.slug && e.title && e.startAt && e.endAt;
  });
  cachePutJson_('events', list, CONFIG.EVENTS_CACHE_SECONDS);
  return list;
}

function allTasks_() {
  var hit = cacheGetJson_('tasks');
  if (hit) return hit;
  var list = readRows_(TABS.TASKS).map(taskFromRow_).filter(function (t) { return t.id && t.eventId && t.day > 0; });
  list.sort(function (a, b) { return a.day - b.day || (a._row - b._row); });
  cachePutJson_('tasks', list, CONFIG.EVENTS_CACHE_SECONDS);
  return list;
}

function tasksOf_(eventId, includeInactive) {
  return allTasks_().filter(function (t) { return t.eventId === eventId && (includeInactive || t.active); });
}

function clearCaches() {
  CacheService.getScriptCache().removeAll(['events', 'tasks', 'settings', 'categories', 'regcounts']);
}

/** Published event by slug (admins may also open drafts). 404 otherwise. */
function eventBySlug_(slug, allowDraft) {
  var s = String(slug || '').trim().toLowerCase();
  var ev = allEvents_().filter(function (e) { return e.slug === s; })[0];
  if (!ev || (!ev.published && !allowDraft)) throw httpError_(404, 'We could not find that event.');
  return ev;
}

function eventById_(id) {
  var ev = allEvents_().filter(function (e) { return e.id === String(id || ''); })[0];
  if (!ev) throw httpError_(404, 'We could not find that event.');
  return ev;
}

// ------------------------------------------------------------------ state

function phase_(ev, now) {
  var t = (now || new Date()).getTime();
  if (t < new Date(ev.startAt).getTime()) return 'upcoming';
  if (t > new Date(ev.endAt).getTime()) return 'completed';
  return 'live';
}

/** open | not_yet | closed | full */
function registrationState_(ev, count, now) {
  var t = (now || new Date()).getTime();
  var opens = ev.regOpensAt ? new Date(ev.regOpensAt).getTime() : 0;
  var closes = ev.regClosesAt ? new Date(ev.regClosesAt).getTime() : new Date(ev.endAt).getTime();
  if (t < opens) return 'not_yet';
  if (t > closes) return 'closed';
  if (ev.maxParticipants > 0 && count >= ev.maxParticipants) return 'full';
  return 'open';
}

/**
 * A task opens on its day (start + day-1 days) unless the sheet gives a date. It
 * closes at the end of the event when late submissions are on, otherwise a day
 * after it opens.
 */
function taskWindow_(task, ev) {
  var start = new Date(ev.startAt).getTime();
  var end = new Date(ev.endAt).getTime();
  var opens = task.opensAt ? new Date(task.opensAt).getTime() : start + (task.day - 1) * DAY_MS;
  var closes = task.closesAt ? new Date(task.closesAt).getTime() : (ev.lateSubmissions ? end : opens + DAY_MS);
  return { opensAt: new Date(opens), closesAt: new Date(Math.min(closes, end)) };
}

function taskState_(task, ev, now) {
  var w = taskWindow_(task, ev);
  var t = (now || new Date()).getTime();
  if (t < w.opensAt.getTime()) return 'locked';
  if (t > w.closesAt.getTime()) return 'closed';
  return 'open';
}

/** Registrations per event ID (registered status only), cached for a minute. */
function registrationCounts_() {
  var hit = cacheGetJson_('regcounts');
  if (hit) return hit;
  var ids = columnValues_(TABS.REGISTRATIONS, 'Event ID');
  var statuses = columnValues_(TABS.REGISTRATIONS, 'Status');
  var out = {};
  ids.forEach(function (id, i) {
    var k = plain_(id);
    if (!k || plain_(statuses[i]) !== 'registered') return;
    out[k] = (out[k] || 0) + 1;
  });
  cachePutJson_('regcounts', out, CONFIG.EVENTS_CACHE_SECONDS);
  return out;
}

function maxScore_(ev, tasks) {
  return tasks.reduce(function (sum, t) { return sum + t.points + t.qualityMax; }, 0) + (ev.pickupBonus || 0);
}

function categories_() {
  var hit = cacheGetJson_('categories');
  if (hit) return hit;
  var list = readRows_(TABS.CATEGORIES)
    .filter(function (r) { return plain_(r['Category']).trim() && (r['Active'] === '' || truthy_(r['Active'])); })
    .sort(function (a, b) { return num_(a['Order'], 99) - num_(b['Order'], 99); })
    .map(function (r) { return plain_(r['Category']).trim(); });
  cachePutJson_('categories', list, CONFIG.EVENTS_CACHE_SECONDS);
  return list;
}

// ------------------------------------------------------------------ public views

function durationDays_(ev) {
  return Math.max(1, Math.round((new Date(ev.endAt).getTime() - new Date(ev.startAt).getTime()) / DAY_MS));
}

function eventCard_(ev, counts, now) {
  var count = counts[ev.id] || 0;
  return {
    id: ev.id,
    slug: ev.slug,
    title: ev.title,
    category: ev.category,
    summary: ev.summary,
    bannerUrl: ev.bannerUrl,
    featured: ev.featured,
    startAt: ev.startAt,
    endAt: ev.endAt,
    durationDays: durationDays_(ev),
    regClosesAt: ev.regClosesAt || ev.endAt,
    participants: count,
    status: phase_(ev, now),
    registration: registrationState_(ev, count, now),
    fee: ev.fee,
  };
}

function publicTask_(task, ev, now) {
  var w = taskWindow_(task, ev);
  return {
    id: task.id,
    day: task.day,
    title: task.title,
    instructions: task.instructions,
    accepts: task.accepts,
    points: task.points,
    qualityMax: task.qualityMax,
    bonus: task.bonusRule === 'karmaverse_pickup' ? ev.pickupBonus : 0,
    bonusRule: task.bonusRule,
    opensAt: w.opensAt.toISOString(),
    closesAt: w.closesAt.toISOString(),
    state: taskState_(task, ev, now),
  };
}

/** GET events.list ?q= &category= &status=upcoming|live|completed &from= &to= (ISO dates) */
function apiEventsList_(p) {
  var now = new Date();
  var counts = registrationCounts_();
  var q = String(p.q || '').trim().toLowerCase().slice(0, 80);
  var category = String(p.category || '').trim();
  var status = String(p.status || '').trim();
  var from = toDate_(p.from);
  var to = toDate_(p.to);
  var list = allEvents_()
    .filter(function (e) { return e.published; })
    .map(function (e) { return eventCard_(e, counts, now); })
    .filter(function (c) {
      if (category && c.category !== category) return false;
      if (status && c.status !== status) return false;
      if (from && new Date(c.endAt) < from) return false;
      if (to && new Date(c.startAt) > to) return false;
      if (q && (c.title + ' ' + c.summary + ' ' + c.category).toLowerCase().indexOf(q) === -1) return false;
      return true;
    });
  var order = { live: 0, upcoming: 1, completed: 2 };
  list.sort(function (a, b) {
    return order[a.status] - order[b.status] ||
      (a.status === 'completed' ? new Date(b.endAt) - new Date(a.endAt) : new Date(a.startAt) - new Date(b.startAt));
  });
  return { events: list.slice(0, 100), categories: categories_() };
}

function eventDetail_(ev, now) {
  var counts = registrationCounts_();
  var tasks = tasksOf_(ev.id);
  var card = eventCard_(ev, counts, now);
  card.overview = ev.overview;
  card.objectives = ev.objectives;
  card.eligibility = ev.eligibility;
  card.rules = ev.rules;
  card.rewards = ev.rewards;
  card.faq = ev.faq;
  card.audience = ev.audience;
  card.regOpensAt = ev.regOpensAt;
  card.maxParticipants = ev.maxParticipants;
  card.lateSubmissions = ev.lateSubmissions;
  card.pickupBonus = ev.pickupBonus;
  card.certificatesEnabled = ev.certificatesEnabled;
  card.maxScore = maxScore_(ev, tasks);
  card.tasks = tasks.map(function (t) { return publicTask_(t, ev, now); });
  card.url = siteUrl_() + '/events/' + ev.slug;
  return card;
}

/** GET events.get ?slug= */
function apiEventGet_(p) {
  return eventDetail_(eventBySlug_(p.slug), new Date());
}

// ==================== Leaderboard.gs ====================

/**
 * Leaderboards are calculated from the PointsLedger only (verified points).
 * Scopes: "event" (one event), "day-N" (points from that event's day N tasks) and
 * "overall" (every event). Ties go to whoever reached the total first, using the
 * time the work was submitted, not the time a reviewer got to it.
 *
 * rebuildLeaderboards() runs every 5 minutes (time trigger), writes every ranking
 * to the Leaderboard tab and caches the top rows for the website.
 */

function standingsFromLedger_(ledger, regs, filter) {
  var people = {};
  regs.forEach(function (r) {
    if (plain_(r['Status']) !== 'registered') return;
    var id = plain_(r['User ID']);
    // For "overall", the latest registration's college and city are shown.
    people[id] = { userId: id, name: plain_(r['Name']), college: plain_(r['College']), city: plain_(r['City']), points: 0, reachedAt: 0 };
  });
  ledger.forEach(function (r) {
    if (!filter(r)) return;
    var u = people[plain_(r['User ID'])];
    if (!u) return;
    var pts = num_(r['Points'], 0);
    u.points += pts;
    var t = (toDate_(r['Earned at']) || toDate_(r['Created at']) || new Date(0)).getTime();
    if (pts > 0 && t > u.reachedAt) u.reachedAt = t;
  });
  return Object.keys(people)
    .map(function (k) { return people[k]; })
    .filter(function (u) { return u.points > 0; })
    .sort(function (a, b) { return b.points - a.points || a.reachedAt - b.reachedAt || (a.userId < b.userId ? -1 : 1); });
}

/** Every ranking, keyed "<eventId>|<scope>" (overall uses eventId ""). */
function computeAllStandings_() {
  var ledger = readRows_(TABS.LEDGER);
  var regs = readRows_(TABS.REGISTRATIONS);
  var out = {};
  allEvents_().filter(function (e) { return e.published; }).forEach(function (ev) {
    var evRegs = regs.filter(function (r) { return plain_(r['Event ID']) === ev.id; });
    out[ev.id + '|event'] = standingsFromLedger_(ledger, evRegs, function (r) { return plain_(r['Event ID']) === ev.id; });
    var days = {};
    tasksOf_(ev.id).forEach(function (t) { days[t.day] = true; });
    Object.keys(days).forEach(function (d) {
      out[ev.id + '|day-' + d] = standingsFromLedger_(ledger, evRegs, function (r) {
        return plain_(r['Event ID']) === ev.id && String(r['Day']) === String(d);
      });
    });
  });
  var published = {};
  allEvents_().forEach(function (e) { if (e.published) published[e.id] = true; });
  out['|overall'] = standingsFromLedger_(ledger, regs, function (r) { return published[plain_(r['Event ID'])]; });
  return out;
}

function publicRow_(u, i) {
  return { rank: i + 1, name: displayName_(u.name), college: u.college, city: u.city, points: u.points };
}

/** Time-trigger entry point (also in the EventHub menu). */
function rebuildLeaderboards() {
  var all = computeAllStandings_();
  var now = new Date();
  var values = [];
  var cache = CacheService.getScriptCache();
  Object.keys(all).forEach(function (key) {
    var parts = key.split('|');
    var rows = all[key];
    rows.forEach(function (u, i) {
      values.push([parts[0], parts[1], i + 1, u.userId, u.name, u.college, u.city, u.points, new Date(u.reachedAt), now]);
    });
    cachePutJson_('lb:' + key, {
      total: rows.length,
      rows: rows.slice(0, CONFIG.LEADERBOARD_CACHE_ROWS).map(publicRow_),
      updatedAt: now.toISOString(),
    }, CONFIG.LEADERBOARD_CACHE_SECONDS);
  });
  var sh = sheet_(TABS.LEADERBOARD);
  var width = TABS.LEADERBOARD.headers.length;
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, width).clearContent();
  if (values.length) sh.getRange(2, 1, values.length, width).setValues(values.map(function (v) { return v.map(safeText_); }));
  cache.remove('lb:dirty');
  return Object.keys(all).length;
}

function leaderboardData_(eventId, scope) {
  var key = eventId + '|' + scope;
  var hit = cacheGetJson_('lb:' + key);
  if (hit) return hit;
  var all = computeAllStandings_();
  var rows = all[key] || [];
  var data = { total: rows.length, rows: rows.slice(0, CONFIG.LEADERBOARD_CACHE_ROWS).map(publicRow_), updatedAt: new Date().toISOString(), full: rows };
  cachePutJson_('lb:' + key, { total: data.total, rows: data.rows, updatedAt: data.updatedAt }, CONFIG.LEADERBOARD_CACHE_SECONDS);
  return data;
}

/**
 * GET leaderboard.get ?slug=<event>|overall &scope=event|day &day=N &page=1 &pageSize=20
 * Public: display name ("Priya S."), college, city and points only.
 */
function apiLeaderboard_(p) {
  var overall = !p.slug || String(p.slug) === 'overall';
  var ev = overall ? null : eventBySlug_(p.slug);
  var scope = overall ? 'overall' : (String(p.scope || 'event') === 'day' ? 'day-' + Math.max(1, Math.floor(num_(p.day, 1))) : 'event');
  var pageSize = Math.max(1, Math.min(CONFIG.PAGE_SIZE_MAX, Math.floor(num_(p.pageSize, 20))));
  var page = Math.max(1, Math.floor(num_(p.page, 1)));
  var data = leaderboardData_(ev ? ev.id : '', scope);
  var start = (page - 1) * pageSize;
  var rows;
  if (start + pageSize <= data.rows.length || data.total <= data.rows.length) {
    rows = data.rows.slice(start, start + pageSize);
  } else {
    // Deep pages beyond the cached top rows come from the Leaderboard tab.
    var full = data.full || leaderboardTabRows_(ev ? ev.id : '', scope);
    rows = full.slice(start, start + pageSize).map(function (u, i) { return publicRow_(u, start + i); });
  }
  return {
    event: ev ? { slug: ev.slug, title: ev.title, days: tasksOf_(ev.id).map(function (t) { return t.day; }) } : null,
    scope: scope,
    page: page,
    pageSize: pageSize,
    total: data.total,
    pages: Math.max(1, Math.ceil(data.total / pageSize)),
    rows: rows,
    updatedAt: data.updatedAt,
  };
}

function leaderboardTabRows_(eventId, scope) {
  return readRows_(TABS.LEADERBOARD)
    .filter(function (r) { return plain_(r['Event ID']) === eventId && plain_(r['Scope']) === scope; })
    .sort(function (a, b) { return num_(a['Rank'], 0) - num_(b['Rank'], 0); })
    .map(function (r) { return { userId: plain_(r['User ID']), name: plain_(r['Name']), college: plain_(r['College']), city: plain_(r['City']), points: num_(r['Points'], 0) }; });
}

/** A participant's rank, from the last rebuild (null when they have no points yet). */
function rankOf_(eventId, scope, userId) {
  var row = rowsWhere_(TABS.LEADERBOARD, 'User ID', userId).filter(function (r) {
    return plain_(r['Event ID']) === eventId && plain_(r['Scope']) === scope;
  })[0];
  return row ? num_(row['Rank'], null) : null;
}

/** Runs every 5 minutes; skips the work when no points changed since the last rebuild. */
function rebuildLeaderboardsIfChanged() {
  if (!CacheService.getScriptCache().get('lb:dirty') && sheet_(TABS.LEADERBOARD).getLastRow() > 1) return 0;
  return rebuildLeaderboards();
}

// ==================== Mail.gs ====================

/**
 * Emails go out through the Workspace account's own Gmail (MailApp). Google allows
 * roughly 1,500 recipients a day on Workspace. When the daily allowance runs low,
 * emails wait in the MailQueue tab and an hourly trigger sends them later.
 */

function sendMail_(to, subject, html) {
  if (!to) return 'skipped';
  var remaining = 0;
  try { remaining = MailApp.getRemainingDailyQuota(); } catch (err) { remaining = 0; }
  if (remaining > 20) {
    MailApp.sendEmail({ to: to, subject: subject, htmlBody: html, name: 'KarmaVerse EventHub' });
    return 'sent';
  }
  appendRow_(TABS.MAIL_QUEUE, { 'Queued at': new Date(), 'To': to, 'Subject': subject, 'Body': html });
  return 'queued';
}

/** Hourly trigger: sends queued emails while the daily allowance lasts. */
function flushMailQueue() {
  var rows = readRows_(TABS.MAIL_QUEUE).filter(function (r) { return !r['Sent at']; });
  var sent = 0;
  for (var i = 0; i < rows.length; i++) {
    if (MailApp.getRemainingDailyQuota() <= 20) break;
    try {
      MailApp.sendEmail({ to: plain_(rows[i]['To']), subject: plain_(rows[i]['Subject']), htmlBody: plain_(rows[i]['Body']), name: 'KarmaVerse EventHub' });
      updateCells_(TABS.MAIL_QUEUE, rows[i]._row, { 'Sent at': new Date(), 'Error': '' });
      sent++;
    } catch (err) {
      updateCells_(TABS.MAIL_QUEUE, rows[i]._row, { 'Error': String(err).slice(0, 300) });
    }
  }
  return sent;
}

function mailLayout_(heading, bodyHtml) {
  var s = getSettings_();
  return '<div style="font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#11201a">' +
    '<div style="background:#0b4d26;color:#fff;padding:18px 22px;border-radius:10px 10px 0 0;font-weight:bold;font-size:18px">KarmaVerse EventHub</div>' +
    '<div style="border:1px solid #dbe4dc;border-top:0;padding:22px;border-radius:0 0 10px 10px">' +
    '<h2 style="margin:0 0 12px;font-size:20px;color:#0b4d26">' + esc_(heading) + '</h2>' + bodyHtml +
    (s.supportEmail ? '<p style="color:#55665d;font-size:13px;margin-top:22px">Questions? Write to ' + esc_(s.supportEmail) + '.</p>' : '') +
    '</div></div>';
}

function sendRegistrationEmail_(ev, name, email) {
  if (!getSettings_().emailsEnabled) return 'disabled';
  var start = Utilities.formatDate(new Date(ev.startAt), CONFIG.TIME_ZONE, 'd MMM yyyy');
  var end = Utilities.formatDate(new Date(ev.endAt), CONFIG.TIME_ZONE, 'd MMM yyyy');
  var link = siteUrl_() + '/events/' + ev.slug + '/participate';
  var body = '<p>Hi ' + esc_(String(name).split(' ')[0]) + ',</p>' +
    '<p>You are registered for <b>' + esc_(ev.title) + '</b>, which runs from ' + start + ' to ' + end + '.</p>' +
    '<p>Each task opens on its day. Submit your proof on the event page, and we will review it. Points count once a submission is approved.</p>' +
    '<p><a href="' + esc_(link) + '" style="display:inline-block;background:#16a34a;color:#fff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:bold">Open my challenge</a></p>' +
    '<p style="color:#55665d;font-size:13px">Or copy this link: ' + esc_(link) + '</p>';
  return sendMail_(email, 'You are registered: ' + ev.title, mailLayout_('Registration confirmed', body));
}

function sendRejectionEmail_(info) {
  var s = getSettings_();
  if (!s.emailsEnabled || !s.rejectionEmails) return 'disabled';
  var ev = eventById_(info.eventId);
  var reg = registrationOf_(info.eventId, info.userId);
  if (!reg) return 'skipped';
  var link = siteUrl_() + '/events/' + ev.slug + '/participate';
  var body = '<p>Hi ' + esc_(plain_(reg['Name']).split(' ')[0]) + ',</p>' +
    '<p>Your submission for <b>Day ' + esc_(info.task.day) + ': ' + esc_(info.task.title) + '</b> in ' + esc_(ev.title) + ' was not approved.</p>' +
    '<p style="background:#fef3c7;padding:10px 12px;border-radius:6px"><b>Reason:</b> ' + esc_(info.reason) + '</p>' +
    (info.task.allowResubmit ? '<p>You can fix this and submit again while the task is open.</p>' : '') +
    '<p><a href="' + esc_(link) + '" style="color:#16a34a;font-weight:bold">Open my challenge</a></p>';
  return sendMail_(plain_(reg['Email']), 'Update on your ' + ev.title + ' submission', mailLayout_('Submission needs changes', body));
}

