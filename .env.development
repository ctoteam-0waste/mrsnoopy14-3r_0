# Loaded by `expo start` / `expo run:*` (development mode only). Local development
# talks to the testing backend; production builds use eas.json / the default in
# src/services/api.ts (https://api.karmaverse.earth).
EXPO_PUBLIC_API_URL=https://karmacoin-backend-11.onrender.com

# EventHub backend: the Apps Script web app URL from eventhub-sheets/README.md
# (https://script.google.com/macros/s/<id>/exec). Leave unset until it is deployed;
# the EventHub pages then show "not connected yet" instead of failing.
# EXPO_PUBLIC_EVENTHUB_API=
